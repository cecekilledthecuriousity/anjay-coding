{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build.js",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/approval",
      "destination": "/approval/index.html"
    },
    {
      "source": "/approval.js",
      "destination": "/approval/approval.js"
    }
  ]
}
