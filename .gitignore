# ==========================================
# Training & Development System (TDS) - .gitignore
# ==========================================

# Operating System Metadata & Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Editor & IDE Directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Build Outputs & Bundler Caches
.cache/
dist/
build/
.parcel-cache/
.turbo/

# Hosting & Cloud Deployment
.vercel
.netlify

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.local

# Logs, Diagnostics & Temp Files
*.log
logs/
temp/
tmp/
*.tmp
*.bak
*.orig
scratch/
test_*.html
test_*.txt

# AI Assistant Scratch & Artifacts
.gemini/
.claude/
*.patch
